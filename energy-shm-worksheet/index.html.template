<!--  SUMMARY OF KEY EQUATIONS                                    -->
<!-- ============================================================ -->
<section>
  <h2>10. Summary of Key Equations</h2>
  <table class="data-table" style="min-width:70%;">
    <tr><th>Quantity</th><th>Equation</th><th>Notes</th></tr>
    <tr><td>Definition of SHM</td><td>a = &minus;&omega;&sup2;x</td><td>Acceleration &prop; &minus;displacement</td></tr>
    <tr><td>Displacement</td><td>x = x<sub>0</sub> sin(&omega;t)</td><td>Or x = x<sub>0</sub> cos(&omega;t)</td></tr>
    <tr><td>Velocity</td><td>v = &omega;x<sub>0</sub> cos(&omega;t)</td><td>Leads x by T/4</td></tr>
    <tr><td>Acceleration</td><td>a = &minus;&omega;&sup2;x<sub>0</sub> sin(&omega;t)</td><td>Antiphase with x</td></tr>
    <tr><td>Velocity&ndash;displacement</td><td>v = &plusmn;&omega;&radic;(x<sub>0</sub>&sup2; &minus; x&sup2;)</td><td>From energy conservation</td></tr>
    <tr><td>Total energy</td><td>E<sub>total</sub> = &frac12;kx<sub>0</sub>&sup2;</td><td>Constant in ideal SHM</td></tr>
    <tr><td>Kinetic energy</td><td>E<sub>k</sub> = &frac12;m&omega;&sup2;(x<sub>0</sub>&sup2; &minus; x&sup2;)</td><td>Maximum at x = 0</td></tr>
    <tr><td>Potential energy</td><td>E<sub>p</sub> = &frac12;kx&sup2;</td><td>Maximum at x = &plusmn;x<sub>0</sub></td></tr>
    <tr><td>Angular frequency</td><td>&omega; = 2&pi;f = &radic;(k/m)</td><td>Mass&ndash;spring system</td></tr>
    <tr><td>Period (spring)</td><td>T = 2&pi;&radic;(m/k)</td><td>Independent of amplitude</td></tr>
    <tr><td>Period (pendulum)</td><td>T = 2&pi;&radic;(L/g)</td><td>Small-angle approximation</td></tr>
    <tr><td>Damped energy</td><td>E(t) = E<sub>0</sub>e<sup>&minus;&gamma;t</sup></td><td>&gamma; = damping constant</td></tr>
  </table>
</section>

